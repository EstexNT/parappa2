vump_bothface:
    NOP                                     BAL VI15, preset_registers_scissor
    NOP                                     NOP
    NOP[e]                                  NOP
    NOP                                     NOP
    NOP                                     XTOP VI11

start_bothface:
    ADDw.x VF23, VF23, VF00w                IADDIU VI02, VI11, 4
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     IADDIU VI03, VI11, 0xd2
    NOP                                     IADD VI04, VI03, VI00
    NOP                                     ILW.x VI07, 0(VI11)
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     ILW.w VI05, 0(VI11)
    NOP                                     LQ.xyzw VF11, 0(VI11)
    NOP                                     IBEQ VI07, VI00, leader_exit_2
    NOP                                     FCSET 0

leader_loop_2:
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     LQI.xyzw VF25, (VI02++)
    NOP                                     LQI.xyzw VF26, (VI02++)
    NOP                                     ISUBIU VI07, VI07, 1
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     SQI.xyzw VF25, (VI03++)
    NOP                                     IBNE VI07, VI00, leader_loop_2
    NOP                                     SQI.xyzw VF26, (VI03++)

leader_exit_2:
    NOP                                     LQ.z VF24, 45(VI00)
    NOP                                     LQ.x VF24, 17(VI00)
    NOP                                     IADD VI11, VI02, VI00
    NOP                                     IADD VI07, VI05, VI00
    SUB.z VF00, VF24, VF00                  IADDIU VI08, VI00, 2
    NOP                                     LQ.xyz VF25, 0(VI02)
    NOP                                     RINIT R, VF24x
    NOP[i]                                  LOI 1.5
    NOP                                     FMAND VI08, VI08
    NOP                                     IBNE VI08, VI00, disturb_vertex_exit_3
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    NOP                                     RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R

disturb_vertex_loop_3:
    NOP                                     LQ.xyz VF25, 3(VI11)
    NOP                                     IADDIU VI11, VI11, 3
    NOP                                     ISUBIU VI07, VI07, 1
    SUBi.xyz VF27, VF26, I                  RINIT R, VF24x
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    MADDz.xyz VF27, VF27, VF24z             RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R
    NOP                                     IBNE VI07, VI00, disturb_vertex_loop_3
    NOP                                     SQ.xyz VF27, -3(VI11)

disturb_vertex_exit_3:
    NOP                                     LQI.xyzw VF17, (VI02++)
    NOP                                     LQI.xyzw VF18, (VI02++)
    NOP                                     LQI.xyzw VF20, (VI02++)
    NOP                                     NOP
    MULAx.xyzw ACC, VF05, VF17x             NOP
    MADDAy.xyzw ACC, VF06, VF17y            NOP
    MADDAz.xyzw ACC, VF07, VF17z            NOP
    MADDw.xyzw VF16, VF08, VF17w            NOP
    MULAx.xyzw ACC, VF01, VF17x             NOP
    MADDAy.xyzw ACC, VF02, VF17y            ISUBIU VI05, VI05, 1
    MADDAz.xyzw ACC, VF03, VF17z            LQI.xyzw VF12, (VI02++)
    MADDw.xyzw VF24, VF04, VF17w            DIV Q, VF00w, VF16w
    MULy.xyz VF18, VF18, VF10y              NOP
    SUBA.xyzw ACC, VF00, VF00               LQI.xyzw VF13, (VI02++)
    NOP                                     NOP
    CLIPw.xyz VF24, VF24w                   LQI.xyzw VF15, (VI02++)
    FTOI0.xyzw VF19, VF18                   MOVE.xyzw VF17, VF12
    ADDAx.z ACC, VF00, VF10x                MOVE.xyzw VF18, VF13
    MADDq.xyzw VF21, VF16, Q                NOP
    MULq.xyzw VF20, VF20, Q                 FCAND VI01, 0x3ffff
    NOP                                     IBEQ VI01, VI00, loop_bothface1

loop_bothface0:
    MULAx[i].xyzw ACC, VF05, VF17x          LOI 2048.0
    ADDI.w VF21, VF00, I                    MOVE.xyzw VF18, VF13

loop_bothface1:
    MADDAy.xyzw ACC, VF06, VF17y            SQI.xyzw VF20, (VI03++)
    MADDAz.xyzw ACC, VF07, VF17z            IBEQ VI05, VI00, end_bothface
    MADDw.xyzw VF16, VF08, VF17w            SQI.xyzw VF19, (VI03++)

loop_bothface2:
    MULAx.xyzw ACC, VF01, VF17x             MTIR VI06, VF15w
    MADDAy.xyzw ACC, VF02, VF17y            ISUBIU VI05, VI05, 1
    MADDAz.xyzw ACC, VF03, VF17z            LQI.xyzw VF12, (VI02++)
    MADDw.xyzw VF24, VF04, VF17w            DIV Q, VF00w, VF16w
    MULy.xyz VF18, VF18, VF10y              IADDIU VI10, VI05, 3
    FTOI4.xyzw VF21, VF21                   LQI.xyzw VF13, (VI02++)
    SUBA.xyzw ACC, VF00, VF00               MOVE.xyzw VF20, VF15
    CLIPw.xyz VF24, VF24w                   LQI.xyzw VF15, (VI02++)
    FTOI0.xyzw VF19, VF18                   MOVE.xyzw VF17, VF12
    ADDAx.z ACC, VF00, VF10x                SQI.xyzw VF21, (VI03++)
    MADDq.xyzw VF21, VF16, Q                IBNE VI06, VI00, loop_bothface0
    MULq.xyzw VF20, VF20, Q                 FCAND VI01, 0x3ffff
    ADDx.xyzw VF18, VF13, VF00x             IBEQ VI01, VI00, loop_bothface1
    MULAx[i].xyzw ACC, VF05, VF17x          LOI 2048.0
    ADDI.w VF21, VF00, I                    BAL VI15, scissor_bothface
    MADDAy.xyzw ACC, VF06, VF17y            SQI.xyzw VF20, (VI03++)

scissor_bothface_return:
    MADDAz.xyzw ACC, VF07, VF17z            IBNE VI05, VI00, loop_bothface2
    MADDw.xyzw VF16, VF08, VF17w            SQI.xyzw VF19, (VI03++)

end_bothface:
    FTOI4.xyzw VF21, VF21                   NOP
    NOP                                     NOP
    NOP                                     SQ.x VF23, 93(VI00)
    NOP[e]                                  XGKICK VI04
    NOP                                     SQI.xyzw VF21, (VI03++) ; Hazard: store on E-bit delay slot
    NOP                                     B start_bothface
    NOP                                     XTOP VI11

scissor_bothface:
    NOP                                     XTOP VI11
    NOP                                     ILW.w VI07, 0(VI11)
    NOP                                     ISUB VI07, VI07, VI10
    NOP                                     LQ.xyzw VF25, -12(VI02)
    NOP                                     IBLTZ VI07, scissor_bothface_return
    NOP                                     LQ.xyzw VF26, -9(VI02)
    NOP                                     LQ.xyzw VF27, -6(VI02)
    NOP                                     IADDI VI13, VI03, -7
    NOP                                     B scissor_polygon ; On vump_menderer_draw_mesh
    NOP                                     SQ.xyzw VF19, 0(VI03)
