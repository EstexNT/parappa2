    SUB.xyzw VF08, VF08, VF07               NOP
    SUB.xy VF10, VF10, VF09                 NOP
    SUB.xyzw VF12, VF12, VF11               NOP
    SUB.xyzw VF02, VF02, VF01               DIV Q, VF25x, VF24x
    ADDAx.xyzw ACC, VF07, VF00x             NOP
    MADDq.xyzw VF08, VF08, Q                WAITQ
    ADDAx.xyzw ACC, VF01, VF00x             NOP
    MADDq.xyzw VF02, VF02, Q                NOP
    ADDAx.xy ACC, VF09, VF00x               NOP
    MADDq.xy VF10, VF10, Q                  DIV Q, VF00w, VF08w
    ADDAx.xyzw ACC, VF11, VF00x             SQ.xyzw VF08, 2(VI12)
    CLIPw.xyz VF02, VF02w                   SQ.xyzw VF02, 72(VI05)
    MADDq.xyzw VF12, VF12, Q                NOP
    NOP                                     NOP
    NOP                                     NOP
    SUB.w VF10, VF00, VF00                  FCGET VI11
    ADDq.z VF10, VF00, Q                    ISW.x VI11, 81(VI05)
    NOP                                     SQ.xyzw VF12, 1(VI12)
    NOP                                     NOP
    NOP                                     JR VI13
    NOP                                     SQ.xyzw VF10, 0(VI12)

