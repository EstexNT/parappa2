    NOP                                     MFP.w VF03, P
    NOP                                     EEXP P, VF02y
    MSUBAx.w ACC, VF03, VF16x               WAITP
    NOP                                     MFP.w VF03, P
    NOP                                     EEXP P, VF02z
    MSUBAy.w ACC, VF03, VF16y               WAITP
    NOP                                     MFP.w VF03, P
    SUB.xyz VF06, VF00, VF00                EEXP P, VF02w
    MSUBAz.w ACC, VF03, VF16z               WAITP
    NOP                                     MFP.w VF03, P
    MSUBw.w VF06, VF03, VF16w               NOP
    NOP[i]                                  LOI 0.0625
    SUBi.xyzw VF15, VF15, I                 NOP
    SUBi[i].xyzw VF14, VF14, I              LOI 24.0
