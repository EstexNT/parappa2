    NOP                                     IADDIU VI07, VI00, 3

menderer_draw_sincos_loop:
    NOP                                     ESIN P, VF27x
    NOP                                     MR32.xyzw VF27, VF27
    ADDAx.w ACC, VF00, VF00x                MR32.xyzw VF24, VF24
    MSUB.w VF01, VF26, VF26                 NOP
    SUB.w VF24, VF00, VF00                  SQRT Q, VF01w
    NOP                                     WAITP
    ADDq.w VF24, VF24, Q                    MFP.w VF27, P
    NOP                                     ESIN P, VF26x
    NOP                                     MR32.xyzw VF26, VF26
    ADDAx.w ACC, VF00, VF00x                MR32.xyzw VF25, VF25
    MSUB.w VF01, VF27, VF27                 NOP
    SUB.w VF25, VF00, VF00                  SQRT Q, VF01w
    NOP                                     WAITP
    ADDq.w VF25, VF25, Q                    MFP.w VF26, P
    NOP                                     IBNE VI07, VI00, menderer_draw_sincos_loop
    NOP                                     ISUBIU VI07, VI07, 1
    ADDAx.w ACC, VF00, VF00x                MR32.xyzw VF24, VF24
    MSUB.w VF01, VF26, VF26                 NOP
    SUB.w VF24, VF00, VF00                  SQRT Q, VF01w
    ADDq.w VF24, VF24, Q                    WAITQ
    ADDAw.xyzw ACC, VF23, VF00w             NOP
    MADD.xyzw VF27, VF27, VF19              NOP
    ADDAw.xyzw ACC, VF22, VF00w             NOP
    MADD.xyzw VF26, VF26, VF18              NOP
    ADDAw.xyzw ACC, VF21, VF00w             NOP
    MADD.xyzw VF25, VF25, VF11              NOP
    ADDAw.xyzw ACC, VF20, VF00w             MOVE.xyzw VF07, VF00
    MADD.xyzw VF24, VF24, VF10              IADDIU VI05, VI00, 15

menderer_draw_loopy:
    ADDx[i].xyzw VF15, VF27, VF00x          LOI 0.083333336
    SUBi.xyzw VF25, VF25, I                 MTIR VI03, VF31x
    SUBi.xyzw VF24, VF24, I                 IADDIU VI06, VI00, 0x18
    ADDx.xyzw VF14, VF26, VF00x             MTIR VI04, VF31x
    ADDx.x VF07, VF00, VF00x                NOP
    MUL.xyzw VF13, VF25, VF25               SQI.xyzw VF30, (VI03++)
    MUL.xyzw VF12, VF24, VF24               MR32.xyzw VF31, VF31

menderer_draw_loopx:
