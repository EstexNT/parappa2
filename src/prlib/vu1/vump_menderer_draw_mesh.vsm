    NOP                                     LQ.xyzw VF01, 4(VI13)
    MULw.xy VF24, VF24, VF10w               LQ.xyzw VF02, 7(VI13)
    MULw.xy VF25, VF25, VF11w               SQ.xyzw VF10, 2(VI03)
    MULw.xy VF26, VF26, VF12w               SQ.xyzw VF11, 5(VI03)
    ITOF0.xyzw VF27, VF27                   SQ.xyzw VF12, 8(VI03)
    ITOF0.xyzw VF01, VF01                   SQ.xyzw VF24, 0(VI03)
    ITOF0.xyzw VF02, VF02                   SQ.xyzw VF25, 3(VI03)
    NOP                                     SQ.xyzw VF26, 6(VI03)
    NOP                                     SQ.xyzw VF27, 1(VI03)
    NOP                                     SQ.xyzw VF01, 4(VI03)
    NOP                                     SQ.xyzw VF02, 7(VI03)

scissor_main:
    ADDx[i].xy VF05, VF00, VF00x            LOI -2.0
    ADDI.w VF05, VF00, I                    BAL VI15, scissor_clip_plane
    ADDw.z VF05, VF00, VF00w                IADDIU VI06, VI00, 0x10
    ADDz.z VF05, VF00, VF00z                BAL VI15, scissor_clip_plane
    ADDw.x VF05, VF00, VF00w                IADDIU VI06, VI00, 1
    ADDx.x VF05, VF00, VF00x                BAL VI15, scissor_clip_plane
    ADDw.y VF05, VF00, VF00w                IADDIU VI06, VI00, 4
    ADDy.w VF05, VF00, VF00y                BAL VI15, scissor_clip_plane
    NOP                                     IADDIU VI06, VI00, 8
    ADDy.y VF05, VF00, VF00y                BAL VI15, scissor_clip_plane
    ADDw.x VF05, VF00, VF00w                IADDIU VI06, VI00, 2
    ADDx.x VF05, VF00, VF00x                BAL VI15, scissor_clip_plane
    ADDw.z VF05, VF00, VF00w                IADDIU VI06, VI00, 0x20

scissor_output:
    NOP                                     LQ.xyzw VF03, 95(VI00)
    NOP                                     LQ.xyzw VF24, 0(VI03)
    NOP                                     LQ.xyzw VF26, 2(VI03)
    NOP                                     LQ.xyzw VF25, 1(VI03)
    SUBA.xyzw ACC, VF00, VF00               IADDIU VI11, VI03, 0
    ADDAx.z ACC, VF00, VF03x                IADDIU VI07, VI00, 0

normalize_output_data_loop14:
    MADDz.xyz VF02, VF26, VF24z             NOP
    MULz.xy VF27, VF24, VF24z               IADDIU VI07, VI07, 1
    FTOI0.xyzw VF01, VF25                   LQ.xyzw VF24, 3(VI11)
    SUB.w VF02, VF00, VF00                  LQ.xyzw VF25, 4(VI11)
    FTOI4.xyz VF02, VF02                    LQ.xyzw VF26, 5(VI11)
    NOP                                     SQI.xy VF27, (VI11++)
    NOP                                     SQI.xyzw VF01, (VI11++)
    SUBA.xyzw ACC, VF00, VF00               IBNE VI07, VI02, normalize_output_data_loop14
    ADDAx.z ACC, VF00, VF03x                SQI.xyzw VF02, (VI11++)
    NOP                                     MTIR VI11, VF06y
    NOP                                     IADDIU VI07, VI02, 0x4000
    NOP                                     IADDIU VI07, VI07, 0x4000
    NOP                                     ISW.x VI07, -1(VI03)
    NOP                                     SQ.xyzw VF06, 92(VI00)
    NOP                                     XGKICK VI11

scissor_restore_registers:
    NOP                                     LQ.xyzw VF25, 102(VI00)
    NOP                                     LQ.xyzw VF01, 105(VI00)
    NOP                                     LQ.xyzw VF02, 106(VI00)
    NOP                                     LQ.xyzw VF03, 107(VI00)
    NOP                                     LQ.xyzw VF04, 108(VI00)
    MULAx.xyzw ACC, VF01, VF25x             LQ.xyzw VF26, 103(VI00)
    MADDAy.xyzw ACC, VF02, VF25y            LQ.xyzw VF27, 104(VI00)
    MADDAz.xyzw ACC, VF03, VF25z            LQ.xyzw VF05, 109(VI00)
    MADDw.xyzw VF25, VF04, VF25w            LQ.xyzw VF06, 110(VI00)
    MULAx.xyzw ACC, VF01, VF26x             LQ.xyzw VF07, 111(VI00)
    MADDAy.xyzw ACC, VF02, VF26y            LQ.xyzw VF08, 112(VI00)
    MADDAz.xyzw ACC, VF03, VF26z            LQ.xyzw VF09, 113(VI00)
    MADDw.xyzw VF26, VF04, VF26w            LQ.xyzw VF10, 94(VI00)
    MULAx.xyzw ACC, VF01, VF27x             LQ.xyzw VF11, 95(VI00)
    MADDAy.xyzw ACC, VF02, VF27y            LQ.xyzw VF12, 96(VI00)
    MADDAz.xyzw ACC, VF03, VF27z            ILW.x VI02, 114(VI00)
    MADDw.xyzw VF27, VF04, VF27w            LQ.xyzw VF24, 101(VI00)
    NOP                                     ILW.y VI03, 114(VI00)
    CLIPw.xyz VF25, VF25w                   ILW.z VI04, 114(VI00)
    CLIPw.xyz VF26, VF26w                   ILW.w VI05, 114(VI00)
    CLIPw.xyz VF27, VF27w                   ILW.x VI06, 115(VI00)
    NOP                                     ILW.y VI14, 115(VI00)
    ADDAx.xyzw ACC, VF24, VF00x             ILW.z VI15, 115(VI00)

scissor_epilogue:
    NOP                                     JR VI15
    NOP                                     NOP
