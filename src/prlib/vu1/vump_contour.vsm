vump_contour:
    NOP                                     BAL VI15, preset_registers
    NOP                                     NOP
    NOP[e]                                  NOP
    NOP                                     NOP
    NOP                                     XTOP VI11

start_contour:
    ADDw.x VF23, VF23, VF00w                IADDIU VI02, VI11, 4
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     IADDIU VI03, VI11, 0xd2
    NOP                                     IADD VI04, VI03, VI00
    NOP                                     ILW.x VI07, 0(VI11)
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     ILW.w VI05, 0(VI11)
    NOP                                     LQ.xyzw VF11, 0(VI11)
    NOP                                     IBEQ VI07, VI00, leader_exit_4
    NOP                                     FCSET 0

leader_loop_4:
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     LQI.xyzw VF25, (VI02++)
    NOP                                     LQI.xyzw VF26, (VI02++)
    NOP                                     ISUBIU VI07, VI07, 1
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     SQI.xyzw VF25, (VI03++)
    NOP                                     IBNE VI07, VI00, leader_loop_4
    NOP                                     SQI.xyzw VF26, (VI03++)

leader_exit_4:
    NOP                                     LQ.z VF24, 45(VI00)
    NOP                                     LQ.x VF24, 17(VI00)
    NOP                                     IADD VI11, VI02, VI00
    NOP                                     IADD VI07, VI05, VI00
    SUB.z VF00, VF24, VF00                  IADDIU VI08, VI00, 2
    NOP                                     LQ.xyz VF25, 0(VI02)
    NOP                                     RINIT R, VF24x
    NOP[i]                                  LOI 1.5
    NOP                                     FMAND VI08, VI08
    NOP                                     IBNE VI08, VI00, disturb_vertex_exit_5
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    NOP                                     RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R

disturb_vertex_loop_5:
    NOP                                     LQ.xyz VF25, 2(VI11)
    NOP                                     IADDIU VI11, VI11, 2
    NOP                                     ISUBIU VI07, VI07, 1
    SUBi.xyz VF27, VF26, I                  RINIT R, VF24x
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    MADDz.xyz VF27, VF27, VF24z             RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R
    NOP                                     IBNE VI07, VI00, disturb_vertex_loop_5
    NOP                                     SQ.xyz VF27, -2(VI11)

disturb_vertex_exit_5:
    NOP                                     LQI.xyzw VF17, (VI02++)
    NOP                                     LQI.xyzw VF18, (VI02++)
    NOP                                     NOP
    MULy.xyzw VF22, VF22, VF10y             NOP
    MULAx.xyzw ACC, VF05, VF17x             NOP
    MADDAy.xyzw ACC, VF06, VF17y            NOP
    MADDAz.xyzw ACC, VF07, VF17z            NOP
    MADDw.xyzw VF16, VF08, VF17w            NOP
    MULAx[i].xyzw ACC, VF01, VF17x          LOI 2048.0
    MADDAy.xyzw ACC, VF02, VF17y            ISUBIU VI05, VI05, 1
    MADDAz.xyzw ACC, VF03, VF17z            LQI.xyzw VF12, (VI02++)
    MADDw.xyzw VF24, VF04, VF17w            DIV Q, VF00w, VF16w
    MULx.w VF18, VF18, VF22x                LQI.xyzw VF13, (VI02++)
    NOP[d]                                  MR32.xyzw VF22, VF22
    SUBA.xyzw ACC, VF00, VF00               NOP
    CLIPw.xyz VF24, VF24w                   NOP
    FTOI0.xyzw VF19, VF18                   MOVE.xyzw VF17, VF12
    ADDAx.z ACC, VF00, VF10x                NOP
    MADDq.xyzw VF21, VF16, Q                NOP
    NOP                                     FCAND VI01, 0x3ffff
    NOP                                     IBEQ VI01, VI00, loop_contour1

loop_contour0:
    MULAx.xyzw ACC, VF05, VF17x             MOVE.xyzw VF18, VF13
    MULi.w VF21, VF00, I                    NOP

loop_contour1:
    MADDAy.xyzw ACC, VF06, VF17y            NOP
    MADDAz.xyzw ACC, VF07, VF17z            IBEQ VI05, VI00, end_contour
    MADDw.xyzw VF16, VF08, VF17w            SQI.xyzw VF19, (VI03++)

loop_contour2:
    MULAx.xyzw ACC, VF01, VF17x             NOP
    MADDAy.xyzw ACC, VF02, VF17y            ISUBIU VI05, VI05, 1
    MADDAz.xyzw ACC, VF03, VF17z            LQI.xyzw VF12, (VI02++)
    MADDw.xyzw VF24, VF04, VF17w            DIV Q, VF00w, VF16w
    MULx.w VF18, VF18, VF22x                LQI.xyzw VF13, (VI02++)
    FTOI4.xyzw VF21, VF21                   MR32.xyzw VF22, VF22
    SUBA.xyzw ACC, VF00, VF00               NOP
    CLIPw.xyz VF24, VF24w                   NOP
    FTOI0.xyzw VF19, VF18                   MOVE.xyzw VF17, VF12
    ADDAx.z ACC, VF00, VF10x                SQI.xyzw VF21, (VI03++)
    MADDq.xyzw VF21, VF16, Q                NOP
    NOP                                     FCAND VI01, 0x3ffff
    NOP                                     IBEQ VI01, VI00, loop_contour1
    MULAx.xyzw ACC, VF05, VF17x             MOVE.xyzw VF18, VF13
    MULi.w VF21, VF00, I                    NOP
    MADDAy.xyzw ACC, VF06, VF17y            NOP
    MADDAz.xyzw ACC, VF07, VF17z            IBNE VI05, VI00, loop_contour2
    MADDw.xyzw VF16, VF08, VF17w            SQI.xyzw VF19, (VI03++)

end_contour:
    FTOI4.xyzw VF21, VF21                   NOP
    NOP                                     NOP
    NOP                                     SQ.x VF23, 93(VI00)
    NOP[e]                                  XGKICK VI04
    NOP                                     SQI.xyzw VF21, (VI03++) ; Hazard: store on E-bit delay slot
    NOP                                     B start_contour
    NOP                                     XTOP VI11
