vump_normal:
    NOP                                     BAL VI15, preset_registers
    NOP                                     NOP
    NOP[e]                                  NOP
    NOP                                     NOP
    NOP                                     XTOP VI11

start_normal:
    ADDw.x VF23, VF23, VF00w                IADDIU VI02, VI11, 4
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     IADDIU VI03, VI11, 0xd2
    NOP                                     IADD VI04, VI03, VI00
    NOP                                     ILW.x VI07, 0(VI11)
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     ILW.w VI05, 0(VI11)
    NOP                                     LQ.xyzw VF11, 0(VI11)
    NOP                                     IBEQ VI07, VI00, leader_exit_0
    NOP                                     FCSET 0

leader_loop_0:
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     LQI.xyzw VF25, (VI02++)
    NOP                                     LQI.xyzw VF26, (VI02++)
    NOP                                     ISUBIU VI07, VI07, 1
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     SQI.xyzw VF25, (VI03++)
    NOP                                     IBNE VI07, VI00, leader_loop_0
    NOP                                     SQI.xyzw VF26, (VI03++)

leader_exit_0:
    NOP                                     LQ.z VF24, 45(VI00)
    NOP                                     LQ.x VF24, 17(VI00)
    NOP                                     IADD VI11, VI02, VI00
    NOP                                     IADD VI07, VI05, VI00
    SUB.z VF00, VF24, VF00                  IADDIU VI08, VI00, 2
    NOP                                     LQ.xyz VF25, 0(VI02)
    NOP                                     RINIT R, VF24x
    NOP[i]                                  LOI 1.5
    NOP                                     FMAND VI08, VI08
    NOP                                     IBNE VI08, VI00, disturb_vertex_exit_1
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    NOP                                     RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R

disturb_vertex_loop_1:
    NOP                                     LQ.xyz VF25, 3(VI11)
    NOP                                     IADDIU VI11, VI11, 3
    NOP                                     ISUBIU VI07, VI07, 1
    SUBi.xyz VF27, VF26, I                  RINIT R, VF24x
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    MADDz.xyz VF27, VF27, VF24z             RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R
    NOP                                     IBNE VI07, VI00, disturb_vertex_loop_1
    NOP                                     SQ.xyz VF27, -3(VI11)

disturb_vertex_exit_1:
    NOP                                     LQI.xyzw VF12, (VI02++)
    NOP                                     LQI.xyzw VF13, (VI02++)
    NOP                                     LQI.xyzw VF15, (VI02++)
    NOP                                     NOP

loop_normal:
    MULAx.xyzw ACC, VF05, VF12x             NOP
    MADDAy.xyzw ACC, VF06, VF12y            NOP
    MADDAz.xyzw ACC, VF07, VF12z            MTIR VI06, VF15w
    MADDw.xyzw VF16, VF08, VF12w            NOP
    MULAx.xyzw ACC, VF01, VF12x             NOP
    MADDAy.xyzw ACC, VF02, VF12y            NOP
    MADDAz[i].xyzw ACC, VF03, VF12z         LOI 255.0
    MADDw.xyzw VF24, VF04, VF12w            DIV Q, VF00w, VF16w
    MINIi.xyzw VF13, VF13, I                NOP
    NOP                                     NOP
    MULz.xyzw VF19, VF19, VF11z             NOP
    CLIPw.xyz VF24, VF24w                   NOP
    MULy.xyz VF13, VF13, VF10y              NOP
    SUBA.xyzw ACC, VF00, VF00               NOP
    ADDAx.z ACC, VF00, VF10x                NOP
    MADDq.xyzw VF16, VF16, Q                NOP
    MULq.xyzw VF15, VF15, Q                 ISUBIU VI05, VI05, 1
    SUB.z VF11, VF00, VF11                  NOP
    FTOI0.xyzw VF13, VF13                   LQI.xyzw VF12, (VI02++)
    SUB[i].xyzw VF18, VF16, VF17            LOI 2048.0
    NOP                                     SQI.xyzw VF15, (VI03++)
    NOP                                     IBNE VI06, VI00, nodisp_normal
    NOP                                     SQI.xyzw VF13, (VI03++)
    OPMULA.xyz ACC, VF19, VF18              NOP
    OPMSUB.xyz VF00, VF18, VF19             NOP
    NOP                                     FCAND VI01, 0x3ffff
    NOP                                     NOP
    NOP                                     IADDIU VI08, VI00, 0x20
    NOP                                     FMAND VI07, VI08
    NOP                                     IBNE VI07, VI00, nodisp_normal
    NOP                                     NOP
    NOP                                     IBEQ VI01, VI00, disp_normal
    NOP                                     IADDIU VI10, VI05, 3

nodisp_normal:
    ADDI.w VF16, VF00, I                    NOP

disp_normal:
scissor_normal_return:
    FTOI4.xyzw VF24, VF16                   LQI.xyzw VF13, (VI02++)
    NOP                                     LQI.xyzw VF15, (VI02++)
    NOP                                     NOP
    NOP                                     NOP
    ADDx.xyzw VF19, VF18, VF00x             IBNE VI05, VI00, loop_normal
    ADDx.xyzw VF17, VF16, VF00x             SQI.xyzw VF24, (VI03++)
    NOP[e]                                  XGKICK VI04
    NOP                                     SQ.x VF23, 93(VI00) ; Hazard: store on E-bit delay slot
    NOP                                     B start_normal
    NOP                                     XTOP VI11

scissor_normal:
    NOP                                     XTOP VI11
    NOP                                     ILW.w VI07, 0(VI11)
    NOP                                     ISUB VI07, VI07, VI10
    NOP                                     LQ.xyzw VF25, -10(VI02)
    NOP                                     IBLTZ VI07, disp_normal
    NOP                                     LQ.xyzw VF26, -7(VI02)
    NOP                                     LQ.xyzw VF27, -4(VI02)
    NOP                                     B scissor_polygon ; On vump_menderer_draw_mesh
    NOP                                     IADDI VI13, VI03, -8
