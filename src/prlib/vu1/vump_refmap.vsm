vump_refmap:
    NOP                                     BAL VI15,preset_registers
    NOP                                     NOP
    NOP[e]                                  NOP
    NOP                                     NOP
    NOP                                     ILW.w VI09, 45(VI00)
    NOP                                     NOP
    NOP                                     NOP
    NOP                                     NOP
    NOP                                     IBEQ VI09, VI00, normal_refmap
    NOP                                     NOP
    NOP                                     MR32.xyz VF09, VF00

normal_refmap:
    NOP                                     XTOP VI11

start_refmap:
    ADDw.x VF23, VF23, VF00w                IADDIU VI02, VI11, 4
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     IADDIU VI03, VI11, 0xd2
    NOP                                     IADD VI04, VI03, VI00
    NOP                                     ILW.x VI07, 0(VI11)
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     ILW.w VI05, 0(VI11)
    NOP                                     LQ.xyzw VF11, 0(VI11)
    NOP                                     IBEQ VI07, VI00, leader_exit_6
    NOP                                     FCSET 0

leader_loop_6:
    NOP                                     LQI.xyzw VF24, (VI02++)
    NOP                                     LQI.xyzw VF25, (VI02++)
    NOP                                     LQI.xyzw VF26, (VI02++)
    NOP                                     ISUBIU VI07, VI07, 1
    NOP                                     SQI.xyzw VF24, (VI03++)
    NOP                                     SQI.xyzw VF25, (VI03++)
    NOP                                     IBNE VI07, VI00, leader_loop_6
    NOP                                     SQI.xyzw VF26, (VI03++)

leader_exit_6:
    NOP                                     LQ.z VF24, 45(VI00)
    NOP                                     LQ.x VF24, 17(VI00)
    NOP                                     IADD VI11, VI02, VI00
    NOP                                     IADD VI07, VI05, VI00
    SUB.z VF00, VF24, VF00                  IADDIU VI08, VI00, 2
    NOP                                     LQ.xyz VF25, 0(VI02)
    NOP                                     RINIT R, VF24x
    NOP[i]                                  LOI 1.5
    NOP                                     FMAND VI08, VI08
    NOP                                     IBNE VI08, VI00, disturb_vertex_exit_7
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    NOP                                     RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R

disturb_vertex_loop_7:
    NOP                                     LQ.xyz VF25, 4(VI11)
    NOP                                     IADDIU VI11, VI11, 4
    NOP                                     ISUBIU VI07, VI07, 1
    SUBi.xyz VF27, VF26, I                  RINIT R, VF24x
    NOP                                     RXOR R, VF25x
    NOP                                     RNEXT.x VF26, R
    NOP                                     RXOR R, VF25y
    MADDz.xyz VF27, VF27, VF24z             RNEXT.y VF26, R
    NOP                                     RXOR R, VF25z
    ADDAx.xyz ACC, VF25, VF00x              RNEXT.z VF26, R
    NOP                                     IBNE VI07, VI00, disturb_vertex_loop_7
    NOP                                     SQ.xyz VF27, -4(VI11)

disturb_vertex_exit_7:
    NOP                                     LQI.xyzw VF12, (VI02++)
    NOP                                     LQI.xyzw VF14, (VI02++)
    NOP                                     LQI.xyzw VF13, (VI02++)
    NOP                                     LQI.xyzw VF15, (VI02++)

loop_refmap:
    MULAx.xyzw ACC, VF05, VF12x             NOP
    MADDAy.xyzw ACC, VF06, VF12y            NOP
    MADDAz.xyzw ACC, VF07, VF12z            MTIR VI06, VF15w
    MADDw.xyzw VF16, VF08, VF12w            NOP
    MULAx.xyzw ACC, VF01, VF12x             NOP
    MADDAy.xyzw ACC, VF02, VF12y            NOP
    MADDAz[i].xyzw ACC, VF03, VF12z         LOI 255.0
    MADDw.xyzw VF24, VF04, VF12w            DIV Q, VF00w, VF16w
    MINIi.xyzw VF13, VF13, I                NOP
    NOP                                     NOP
    CLIPw.xyz VF24, VF24w                   NOP
    MULAx.xyzw ACC, VF28, VF12x             NOP
    MADDAy.xyzw ACC, VF29, VF12y            NOP
    MADDAz.xyzw ACC, VF30, VF12z            NOP
    MADDw.xyzw VF25, VF31, VF12w            NOP
    MULAx.xyzw ACC, VF28, VF14x             NOP
    MADDAy.xyzw ACC, VF29, VF14y            NOP
    MADDz.xyzw VF24, VF30, VF14z            NOP
    SUB.xyz VF25, VF25, VF09                NOP
    NOP                                     ERLENG P, VF25
    MULq.w VF20, VF00, Q                    NOP
    MUL.xyz VF26, VF24, VF24                NOP
    ADDy.x VF26, VF26, VF26y                NOP
    ADDz.x VF26, VF26, VF26z                NOP
    MUL.xyz VF27, VF24, VF25                DIV Q, VF00w, VF26x
    ADDy.x VF27, VF27, VF27y                NOP
    ADDz.x VF27, VF27, VF27z                NOP
    ADD.xyz VF24, VF24, VF24                LQ.xyzw VF26, 46(VI00)
    MULx.xyz VF24, VF24, VF27x              WAITQ
    MULq[i].xyz VF24, VF24, Q               LOI 1.0
    SUB.xyz VF24, VF24, VF25                WAITP
    ADDI.z VF24, VF00, I                    MFP.x VF25, P
    MULx[i].xy VF24, VF24, VF25x            LOI 0.5
    ADDw.xy VF24, VF24, VF00w               NOP
    ADDAx.xyzw ACC, VF26, VF00x             NOP
    MADDi.xy VF15, VF24, I                  NOP
    MULz.xyzw VF19, VF19, VF11z             LQI.xyzw VF12, (VI02++)
    MULy.xyz VF13, VF13, VF10y              NOP
    SUBA.xyzw ACC, VF00, VF00               NOP
    ADDAx.z ACC, VF00, VF10x                NOP
    MADDw.xyzw VF16, VF16, VF20w            NOP
    MULw.xyzw VF15, VF15, VF20w             NOP
    SUB.z VF11, VF00, VF11                  NOP
    FTOI0.xyzw VF13, VF13                   NOP
    SUB[i].xyzw VF18, VF16, VF17            LOI 2048.0
    NOP                                     SQI.xyzw VF15, (VI03++)
    NOP                                     IBNE VI06, VI00, nodisp_refmap
    NOP                                     SQI.xyzw VF13, (VI03++)
    OPMULA.xyz ACC, VF19, VF18              IADDIU VI07, VI00, 0
    OPMSUB.xyz VF00, VF18, VF19             NOP
    NOP                                     FCAND VI01, 0x3ffff
    NOP                                     NOP
    NOP                                     IADDIU VI08, VI00, 0x20
    NOP                                     FMAND VI07, VI08
    NOP                                     IBNE VI07, VI00, nodisp_refmap
    NOP                                     NOP
    NOP                                     IBEQ VI01, VI00, disp_refmap
    NOP                                     IADDIU VI10, VI05, 3

nodisp_refmap:
    ADDI.w VF16, VF00, I                    NOP

disp_refmap:
scissor_refmap_return:
    FTOI4.xyzw VF24, VF16                   LQI.xyzw VF14, (VI02++)
    NOP                                     LQI.xyzw VF13, (VI02++)
    NOP                                     ISUBIU VI05, VI05, 1
    NOP                                     LQI.xyzw VF15, (VI02++)
    ADDx.xyzw VF19, VF18, VF00x             IBNE VI05, VI00, loop_refmap
    ADDx.xyzw VF17, VF16, VF00x             SQI.xyzw VF24, (VI03++)
    NOP[e]                                  XGKICK VI04
    NOP                                     SQ.x VF23, 93(VI00) ; Hazard: store on E-bit delay slot
    NOP                                     B start_refmap
    NOP                                     XTOP VI11

scissor_refmap:
    NOP                                     XTOP VI11
    NOP                                     ILW.w VI07, 0(VI11)
    NOP                                     ISUB VI07, VI07, VI10
    NOP                                     LQ.xyzw VF25, -10(VI02)
    NOP                                     IBLTZ VI07, disp_refmap
    NOP                                     LQ.xyzw VF26, -7(VI02)
    NOP                                     LQ.xyzw VF27, -4(VI02)
    NOP                                     B scissor_polygon ; On vump_menderer_draw_mesh
    NOP                                     IADDI VI13, VI03, -8
